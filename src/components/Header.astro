---
import Logo from "./Logo.astro";

const links = [
  { href: "/#updawg", label: "Updawg" },
  { href: "/#founder", label: "Founder" },
  { href: "/#company", label: "Company" },
];
---

<header class="sticky top-0 z-40 border-b border-border bg-bg/85 backdrop-blur-sm">
  <div class="mx-auto flex max-w-5xl items-center gap-6 px-5 py-3 sm:px-8">
    <a href="/" class="flex items-center gap-2 font-semibold tracking-tight">
      <Logo />
      Pez Solutions
    </a>

    <nav
      aria-label="Sections"
      class="-mx-1 flex min-w-0 flex-1 gap-1 overflow-x-auto text-[13px] text-muted"
    >
      {links.map((l) => (
        <a
          href={l.href}
          class="shrink-0 rounded-md px-2 py-1 whitespace-nowrap hover:bg-surface-2 hover:text-text"
        >
          {l.label}
        </a>
      ))}
    </nav>

    <a
      href="https://updawg.net"
      class="hidden h-8 shrink-0 items-center rounded-md bg-primary px-3 text-[13px] font-medium whitespace-nowrap text-primary-fg transition-colors hover:bg-primary-hover sm:inline-flex"
    >
      Visit updawg.net
    </a>
  </div>
</header>
