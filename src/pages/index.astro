---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import UpdawgLogo from "../components/UpdawgLogo.astro";
import rasmus from "../assets/rasmus.jpeg";

const updawg = [
  {
    title: "See what is pending",
    body: "Every pending package update on every host, and which of them matter.",
  },
  {
    title: "Let policy approve the routine",
    body: "Your rules approve the safe updates; the risky ones wait for a person.",
  },
  {
    title: "Signed jobs, nothing arbitrary",
    body: "The agent on each host applies only jobs signed with your organization's key.",
  },
  {
    title: "Your data, your region",
    body: "Each organization's fleet data lives in the EU or the US, as it chooses.",
  },
];

const updawgLinks = [
  { href: "https://updawg.net", label: "updawg.net" },
  { href: "https://docs.updawg.net", label: "Documentation" },
  { href: "https://docs.updawg.net/changelog/", label: "Changelog" },
  { href: "https://app.updawg.net/sign-up", label: "Start free" },
];

const founderLinks = [
  { href: "https://www.linkedin.com/in/rwejlgaard", label: "LinkedIn" },
  { href: "https://github.com/rwejlgaard", label: "GitHub" },
];

const company = [
  { label: "Company", value: "Pez Solutions Ltd" },
  { label: "Registered in", value: "England and Wales" },
  {
    label: "Company number",
    value: "17515727",
    href: "https://find-and-update.company-information.service.gov.uk/company/17515727",
  },
  {
    label: "Registered office",
    value: "167-169 Great Portland Street, 5th Floor, London W1W 5PF",
  },
  {
    label: "Contact",
    value: "hello@updawg.net",
    href: "mailto:hello@updawg.net",
  },
  {
    label: "Security reports",
    value: "security@updawg.net",
    href: "https://updawg.net/security/",
  },
];
---

<Base
  title="Pez Solutions — the company behind Updawg"
  description="Pez Solutions Ltd is a London software company. We build Updawg, which keeps Linux servers patched."
>
  <section class="mx-auto max-w-5xl px-5 pt-20 pb-16 sm:px-8 sm:pt-28">
    <p class="text-sm font-medium text-muted">Pez Solutions Ltd · London</p>
    <h1 class="mt-4 max-w-3xl text-4xl font-semibold tracking-tight sm:text-5xl">
      We build software that keeps Linux servers patched.
    </h1>
    <p class="mt-6 max-w-2xl text-lg text-muted">
      Pez Solutions is a small software company in London. Our product is
      Updawg: it shows a team every pending update across its servers, lets
      policy approve the routine ones and applies them safely.
    </p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a
        href="https://updawg.net"
        class="inline-flex h-10 items-center rounded-md bg-primary px-4 text-sm font-medium text-primary-fg transition-colors hover:bg-primary-hover"
      >
        Meet Updawg
      </a>
      <a
        href="mailto:hello@updawg.net"
        class="inline-flex h-10 items-center rounded-md border border-border-strong px-4 text-sm font-medium hover:bg-surface-2"
      >
        Get in touch
      </a>
    </div>
  </section>

  <section id="updawg" class="border-t border-border bg-surface-2">
    <div class="mx-auto max-w-5xl px-5 py-16 sm:px-8">
      <div class="flex items-center gap-3">
        <UpdawgLogo class="size-9" />
        <h2 class="text-2xl font-semibold tracking-tight">Updawg</h2>
      </div>
      <p class="mt-4 max-w-2xl text-muted">
        Patch management for Linux fleets, from a homelab to thousands of hosts.
        A small agent on each server reports what is pending; the portal decides
        what goes out and when, and every change is recorded.
      </p>
      <ul class="mt-10 grid gap-4 sm:grid-cols-2">
        {updawg.map((f) => (
          <li class="rounded-lg border border-border bg-surface p-5 shadow-(--shadow-card)">
            <h3 class="font-semibold">{f.title}</h3>
            <p class="mt-2 text-sm text-muted">{f.body}</p>
          </li>
        ))}
      </ul>
      <div class="mt-8 flex flex-wrap gap-x-5 gap-y-2 text-sm">
        {updawgLinks.map((l) => (
          <a
            class="font-medium text-primary underline underline-offset-4"
            href={l.href}
          >
            {l.label}
          </a>
        ))}
      </div>
    </div>
  </section>

  <section id="founder" class="border-t border-border">
    <div class="mx-auto max-w-5xl px-5 py-16 sm:px-8">
      <h2 class="text-2xl font-semibold tracking-tight">Founder</h2>
      <div class="mt-8 flex flex-col gap-6 sm:flex-row sm:items-start sm:gap-8">
        <Image
          src={rasmus}
          alt="Rasmus Wejlgaard"
          width={160}
          height={160}
          densities={[1, 2]}
          class="h-32 w-32 shrink-0 rounded-full border border-border object-cover sm:h-40 sm:w-40"
        />
        <div class="max-w-2xl">
          <h3 class="text-xl font-semibold">Rasmus Wejlgaard</h3>
          <p class="mt-1 text-sm font-medium text-muted">Founder & CEO</p>
          <p class="mt-4 text-muted">
            I've spent over ten years in platform and cloud engineering, at
            companies including CapitalOnTap, Expedia Group and GoHenry. At home
            I run about a dozen servers of my own, and keeping them updated was
            eating the time I wanted to spend using them.
          </p>
          <p class="mt-4 text-muted">
            I founded Pez Solutions Ltd in 2026 to build the tool I wanted for
            them, for every team with the same problem.
          </p>
          <div class="mt-5 flex flex-wrap gap-x-5 gap-y-2 text-sm">
            {founderLinks.map((l) => (
              <a
                class="font-medium text-primary underline underline-offset-4"
                href={l.href}
                rel="me"
              >
                {l.label}
              </a>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="company" class="border-t border-border">
    <div class="mx-auto max-w-5xl px-5 py-16 sm:px-8">
      <h2 class="text-2xl font-semibold tracking-tight">The company</h2>
      <dl class="mt-8 grid max-w-3xl gap-x-8 gap-y-4 text-sm sm:grid-cols-[12rem_1fr]">
        {company.map((row) => (
          <>
            <dt class="text-subtle">{row.label}</dt>
            <dd class="-mt-3 sm:mt-0">
              {row.href ? (
                <a
                  class="underline underline-offset-4 hover:text-primary"
                  href={row.href}
                >
                  {row.value}
                </a>
              ) : (
                row.value
              )}
            </dd>
          </>
        ))}
      </dl>
    </div>
  </section>
</Base>
